# ─────────────────────────────────────────────────────────────────────────────
# Setter Copilot — variables de entorno
# Copiá este archivo a `.env` (o `.env.local` para Next) y completá los valores.
# NUNCA commitees valores reales. Todas se validan con Zod en src/lib/env.ts.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública de la app (links de baja, callbacks de OAuth).
APP_URL=http://localhost:3000

# ── Base de datos ────────────────────────────────────────────────────────────
# Conexión directa a Postgres (NO aplica RLS). Solo servidor y worker.
# Supabase local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Postgres donde los tests de base pueden crear bases efímeras (pnpm test:db).
# Puede ser el mismo servidor que DATABASE_URL.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Supabase ─────────────────────────────────────────────────────────────────
# `pnpm supabase:start` imprime estos valores para el entorno local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Saltea RLS: solo en el servidor, jamás en código que llegue al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cifrado ──────────────────────────────────────────────────────────────────
# Clave AES-256-GCM para tokens OAuth en reposo. 32 bytes en base64:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ── IA (Anthropic) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Modelos configurables: nunca se hardcodean en el código.
# FAST: investigación, clasificación y scoring. SMART: redacción y conversación.
# Modelos disponibles: https://docs.anthropic.com/en/docs/about-claude/models
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-opus-5-5
# Esfuerzo de razonamiento por tier: low | medium | high | xhigh | max | none
# ("none" no envía el parámetro; usalo con modelos que no lo soportan).
AI_EFFORT_FAST=low
AI_EFFORT_SMART=medium
# Precios en USD por millón de tokens, para estimar el costo en ai_runs.
# Valores de referencia (lista de Anthropic consultada el 2026-10-06; Haiku 5.5:
# precio para prompts de hasta 100K tokens). Verificalos antes de producción:
# https://www.anthropic.com/pricing — Si quedan vacíos, el costo se registra como null.
AI_PRICE_FAST_INPUT_PER_MTOK=0.10
AI_PRICE_FAST_OUTPUT_PER_MTOK=0.50
AI_PRICE_SMART_INPUT_PER_MTOK=4.00
AI_PRICE_SMART_OUTPUT_PER_MTOK=20.00
# Solo desarrollo/tests: respuestas simuladas sin llamar a la API. Prohibido en producción.
AI_FAKE=false

# ── Fuentes de datos públicos de negocios ────────────────────────────────────
# Deshabilitadas por defecto. Antes de activar una, verificá su costo vigente en
# la página oficial y documentalo en su archivo (src/server/prospects/sources/).
# Google Places: https://developers.google.com/maps/billing-and-pricing/pricing
PROSPECT_SOURCE_GOOGLE_PLACES_ENABLED=false

# ── Operación ────────────────────────────────────────────────────────────────
# Zona horaria por defecto para horario hábil si el prospecto no tiene una.
DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires

# Worker de jobs (pnpm worker).
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=4
# Puerto opcional del health check HTTP del worker (Render/Fly).
# WORKER_HEALTH_PORT=8080

# ── Email (Gmail por OAuth) ──────────────────────────────────────────────────
# Credenciales OAuth de Google Cloud (tipo "Aplicación web"). URI de redirección:
#   ${APP_URL}/api/oauth/google/callback
# Scopes que se piden: gmail.send y gmail.readonly (para detectar respuestas y
# rebotes). gmail.readonly es un scope restringido: para producción con usuarios
# externos Google exige verificación de la app. Ver:
# https://developers.google.com/identity/protocols/oauth2/production-readiness/restricted-scope-verification
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Firma de los links de baja (mínimo 32 caracteres): openssl rand -base64 48
UNSUBSCRIBE_SIGNING_SECRET=
# Espaciado aleatorio entre emails de una misma casilla, en segundos.
EMAIL_MIN_GAP_SECONDS=120
EMAIL_MAX_GAP_SECONDS=420
EMAIL_DISPATCH_INTERVAL_MS=60000
EMAIL_SYNC_INTERVAL_MS=300000
# Solo tests (mock de Google). En producción no las definas.
# GOOGLE_OAUTH_AUTHORIZE_URL=
# GOOGLE_OAUTH_TOKEN_URL=
# GOOGLE_OAUTH_REVOKE_URL=
# GMAIL_API_URL=

# ── Próximas fases (todavía sin uso) ─────────────────────────────────────────
# Fase 6 — Meta / TikTok for Business
# META_APP_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
