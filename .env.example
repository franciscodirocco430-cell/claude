# ─────────────────────────────────────────────────────────────────────────────
# Setter Copilot — variables de entorno
# Copiá este archivo a `.env` (o `.env.local` para Next) y completá los valores.
# NUNCA commitees valores reales. Todas se validan con Zod en src/lib/env.ts.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública de la app (links de baja, callbacks de OAuth).
APP_URL=http://localhost:3000

# ── Base de datos ────────────────────────────────────────────────────────────
# Conexión directa a Postgres (NO aplica RLS). Solo servidor y worker.
# Supabase local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Postgres donde los tests de base pueden crear bases efímeras (pnpm test:db).
# Puede ser el mismo servidor que DATABASE_URL.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Supabase ─────────────────────────────────────────────────────────────────
# `pnpm supabase:start` imprime estos valores para el entorno local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Saltea RLS: solo en el servidor, jamás en código que llegue al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cifrado ──────────────────────────────────────────────────────────────────
# Clave AES-256-GCM para tokens OAuth en reposo. 32 bytes en base64:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ── IA (Anthropic) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Modelos configurables: nunca se hardcodean en el código.
# FAST: clasificación y scoring. SMART: redacción y conversación.
# Ver modelos disponibles en https://docs.anthropic.com/en/docs/about-claude/models
AI_MODEL_FAST=
AI_MODEL_SMART=
# Precios en USD por millón de tokens, para estimar el costo en ai_runs.
# Si quedan vacíos, el costo se registra como null. Actualizalos si cambiás de
# modelo: https://www.anthropic.com/pricing
AI_PRICE_FAST_INPUT_PER_MTOK=
AI_PRICE_FAST_OUTPUT_PER_MTOK=
AI_PRICE_SMART_INPUT_PER_MTOK=
AI_PRICE_SMART_OUTPUT_PER_MTOK=

# ── Operación ────────────────────────────────────────────────────────────────
# Zona horaria por defecto para horario hábil si el prospecto no tiene una.
DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires

# Worker de jobs (pnpm worker).
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=4

# ── Próximas fases (todavía sin uso) ─────────────────────────────────────────
# Fase 5 — Google OAuth (Gmail + Calendar)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# UNSUBSCRIBE_SIGNING_SECRET=
# Fase 6 — Meta / TikTok for Business
# META_APP_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
