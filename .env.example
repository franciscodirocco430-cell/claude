# Supabase
# Project URL and public anon key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key — server-only. Never expose to the client.
# Used for AI analysis jobs and admin operations that bypass RLS intentionally.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI provider (see /lib/ai/provider.ts)
# Determines which provider implementation is instantiated. Currently "anthropic" is implemented.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: alternate providers (adapters are stubbed for future use)
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo seed script (scripts/seed-demo.ts)
DEMO_USER_EMAIL=demo@contentintelligence.app
